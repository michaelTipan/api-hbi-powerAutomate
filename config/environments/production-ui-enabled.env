# =============================================================================
# Overlay PRODUCCIÓN + UI ON — rutas reales + escrituras UI opt-in
# =============================================================================
# Uso: .\scripts\switch-env.ps1 -Target production-ui-enabled
# Hereda paths de production.env (clientes reales, Contabilidad, sin PRUEBAS).
# Mutaciones SharePoint de smoke (ACCOUNTING_FOLDER_SMOKE) permanecen apagadas.
# CUIDADO: UI writes operan sobre clientes reales.
# =============================================================================

ACTIVE_ENVIRONMENT=production
ENV_READY=true

# -----------------------------------------------------------------------------
# CLIENTES (raíz productiva; sandbox excluido)
# -----------------------------------------------------------------------------
GRAPH_CLIENTS_BASE_PATH=INFORMACION CREDITOS-CLIENTES
GRAPH_CLIENTS_EXCLUDED_FOLDERS=03 COMWARE PRUEBAS- INFORMACION CREDITOS CLIENTES

# -----------------------------------------------------------------------------
# REPORTES DE BANCO
# -----------------------------------------------------------------------------
PAYMENT_BANK_BOGOTA_INPUT_FILE_PATH=INFORMACION CREDITOS-CLIENTES/01 CARGA TRANSACCIONES BANCO/BANCO_BOGOTA.xlsx
PAYMENT_BANK_BANCOLOMBIA_INPUT_FILE_PATH=INFORMACION CREDITOS-CLIENTES/01 CARGA TRANSACCIONES BANCO/BANCO_BANCOLOMBIA.xlsx
GRAPH_SHAREPOINT_FILE_PATH=INFORMACION CREDITOS-CLIENTES/01 CARGA TRANSACCIONES BANCO/BANCO_BOGOTA.xlsx

# -----------------------------------------------------------------------------
# VALIDACIÓN DE PAGOS
# -----------------------------------------------------------------------------
PAYMENT_VALIDATION_BASE_FOLDER=INFORMACION CREDITOS-CLIENTES/02 VALIDACION PAGOS
PAYMENT_VALIDATION_CONTROL_FOLDER=90 ACCESO RESTRINGIDO/03 CONTROL TECNICO
PAYMENT_VALIDATION_REVIEW_FOLDER=01 REVISION
PAYMENT_VALIDATION_HISTORICAL_FOLDER=03 HISTORICO
PAYMENT_VALIDATION_LOGS_FOLDER=90 ACCESO RESTRINGIDO/01 TRAZABILIDAD
PAYMENT_VALIDATION_EXECUTION_LOGS_FOLDER=90 ACCESO RESTRINGIDO/02 LOGS
PAYMENT_VALIDATION_ARCHIVE_FOLDER=90 ACCESO RESTRINGIDO/04 ARCHIVO PROCESOS
PAYMENT_VALIDATION_EMAIL_FOLDER=04 CORREOS ENVIADOS

# Carpeta asientos/consolidados de sandbox: desactivar en producción.
UNSET_KEYS=PAYMENT_VALIDATION_ASIENTOS_FOLDER,GRAPH_MERGE_COMPOSITE_OUTPUT_FOLDER_PATH

EXECUTION_RUN_LOG_ENABLED=true

# -----------------------------------------------------------------------------
# CONTABILIDAD (destino PDF consolidados)
# -----------------------------------------------------------------------------
GRAPH_ACCOUNTING_SITE_HOSTNAME=gecolsacat.sharepoint.com
GRAPH_ACCOUNTING_SITE_PATH=sites/HBICapitalContabilidad
GRAPH_ACCOUNTING_DRIVE_NAME=Documentos
GRAPH_ACCOUNTING_BOGOTA_FOLDER_NAME=INGRESOS BANCO BOGOTA
GRAPH_ACCOUNTING_BANCOLOMBIA_FOLDER_NAME=INGRESOS PA BANCOLOMBIA

# Nunca crear/mover carpetas de Contabilidad en smoke.
ACCOUNTING_FOLDER_SMOKE_ENABLED=false

# -----------------------------------------------------------------------------
# ARCHIVOS OPERATIVOS (02 CONTROL OPERATIVO)
# -----------------------------------------------------------------------------
GRAPH_VALIDAR_NOTIFY_CORREOS_XLSX_PATH=INFORMACION CREDITOS-CLIENTES/02 VALIDACION PAGOS/02 CONTROL OPERATIVO/CORREOS.xlsx
GRAPH_IBR_DIARIO_PATH=INFORMACION CREDITOS-CLIENTES/02 VALIDACION PAGOS/02 CONTROL OPERATIVO/IBR_DIARIO.xlsx
GRAPH_FOLLOWUP_PAGOS_ADELANTADOS_PATH=INFORMACION CREDITOS-CLIENTES/02 VALIDACION PAGOS/02 CONTROL OPERATIVO/pagos_adelantados.xlsx

# -----------------------------------------------------------------------------
# Extract-index PAUSADO — prohibido activar en este overlay (operador UI)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# UI operador (opt-in producción)
# -----------------------------------------------------------------------------
UI_ENABLED=true
UI_WRITE_ENABLED=true
UI_FINALIZE_ENABLED=true
UI_NOTIFY_ENABLED=true
UI_MERGE_ENABLED=true
UI_AMORTIZATION_ENABLED=true
# Historial UI/API oculto hasta lista SharePoint; archivo Apply intacto.
UI_HISTORY_ENABLED=false
UI_AUTH_MODE=local_session
UI_COOKIE_SECURE=true
