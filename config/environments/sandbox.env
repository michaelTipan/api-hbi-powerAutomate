# =============================================================================
# Overlay SANDBOX / pruebas — rutas SharePoint bajo la carpeta de pruebas Comware
# =============================================================================
# Lo aplica: scripts/switch-env.ps1 -Target sandbox
# Destino principal de deploy: ../api-hbi-powerAutomate.env (fuera del repo git)
# No incluye secretos (API_HTTP_KEY, GRAPH_CLIENT_ID, Key Vault): se conservan.
#
# Carpeta raíz de pruebas (renombrada 2026-07-29):
#   INFORMACION CREDITOS-CLIENTES/03 COMWARE PRUEBAS- INFORMACION CREDITOS CLIENTES
# =============================================================================

ACTIVE_ENVIRONMENT=sandbox

# -----------------------------------------------------------------------------
# CLIENTES (sandbox)
# -----------------------------------------------------------------------------
GRAPH_CLIENTS_BASE_PATH=INFORMACION CREDITOS-CLIENTES/03 COMWARE PRUEBAS- INFORMACION CREDITOS CLIENTES
GRAPH_CLIENTS_EXCLUDED_FOLDERS=

# -----------------------------------------------------------------------------
# REPORTES DE BANCO
# -----------------------------------------------------------------------------
PAYMENT_BANK_BOGOTA_INPUT_FILE_PATH=INFORMACION CREDITOS-CLIENTES/03 COMWARE PRUEBAS- INFORMACION CREDITOS CLIENTES/01 CARGA TRANSACCIONES BANCO/BANCO_BOGOTA.xlsx
PAYMENT_BANK_BANCOLOMBIA_INPUT_FILE_PATH=INFORMACION CREDITOS-CLIENTES/03 COMWARE PRUEBAS- INFORMACION CREDITOS CLIENTES/01 CARGA TRANSACCIONES BANCO/BANCO_BANCOLOMBIA.xlsx
GRAPH_SHAREPOINT_FILE_PATH=INFORMACION CREDITOS-CLIENTES/03 COMWARE PRUEBAS- INFORMACION CREDITOS CLIENTES/01 CARGA TRANSACCIONES BANCO/BANCO_BOGOTA.xlsx

# -----------------------------------------------------------------------------
# VALIDACIÓN DE PAGOS
# -----------------------------------------------------------------------------
PAYMENT_VALIDATION_BASE_FOLDER=INFORMACION CREDITOS-CLIENTES/03 COMWARE PRUEBAS- INFORMACION CREDITOS CLIENTES/02 VALIDACION PAGOS
PAYMENT_VALIDATION_CONTROL_FOLDER=90 ACCESO RESTRINGIDO/03 CONTROL TECNICO
PAYMENT_VALIDATION_REVIEW_FOLDER=01 REVISION
PAYMENT_VALIDATION_HISTORICAL_FOLDER=03 HISTORICO
PAYMENT_VALIDATION_LOGS_FOLDER=90 ACCESO RESTRINGIDO/01 TRAZABILIDAD
PAYMENT_VALIDATION_EXECUTION_LOGS_FOLDER=90 ACCESO RESTRINGIDO/02 LOGS
PAYMENT_VALIDATION_EMAIL_FOLDER=04 CORREOS ENVIADOS
# Consolidados de Merge en pruebas: se quedan en Operaciones (Contabilidad apagada).
PAYMENT_VALIDATION_ASIENTOS_FOLDER=99 SOPORTES DE PAGO CONSOLIDADOS - PRUEBAS

EXECUTION_RUN_LOG_ENABLED=true

# Contabilidad deshabilitada en pruebas (hostname vacío → Merge usa carpeta sandbox)
GRAPH_ACCOUNTING_SITE_HOSTNAME=
GRAPH_ACCOUNTING_SITE_PATH=

# Prueba de humo que crea carpetas en Contabilidad: solo bajo petición explícita.
ACCOUNTING_FOLDER_SMOKE_ENABLED=false

# -----------------------------------------------------------------------------
# ARCHIVOS OPERATIVOS
# -----------------------------------------------------------------------------
GRAPH_VALIDAR_NOTIFY_CORREOS_XLSX_PATH=INFORMACION CREDITOS-CLIENTES/03 COMWARE PRUEBAS- INFORMACION CREDITOS CLIENTES/02 VALIDACION PAGOS/02 CONTROL OPERATIVO/CORREOS.xlsx
GRAPH_IBR_DIARIO_PATH=INFORMACION CREDITOS-CLIENTES/03 COMWARE PRUEBAS- INFORMACION CREDITOS CLIENTES/02 VALIDACION PAGOS/02 CONTROL OPERATIVO/IBR_DIARIO.xlsx
GRAPH_FOLLOWUP_PAGOS_ADELANTADOS_PATH=INFORMACION CREDITOS-CLIENTES/03 COMWARE PRUEBAS- INFORMACION CREDITOS CLIENTES/02 VALIDACION PAGOS/02 CONTROL OPERATIVO/pagos_adelantados.xlsx
